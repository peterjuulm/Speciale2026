# Text belongs in git: environment blocks, hash lists, logs.
# Bytes do not: build output, packages, archives.
bin/
obj/
build/
__pycache__/
.venv/
*.nupkg
*.zip
*.dll
*.pdb

# Third-party packages mirrored for reading, not redistributed: no license.
external/*/osf/

# Dependency census lists name every package and version Phoenix ships: kept
# out of this public repo (12/10). Regenerate them with the run's kommando.txt.
data/*-dependency-census/*/census.*
data/*-dependency-census/*/left-out.md
data/*-declared-env*/*/declared-env.*
data/*-symbol-servers/*/symbols.*
