# Text belongs in git: environment blocks, hash lists, logs.
# Bytes do not: build output, packages, archives.
bin/
obj/
build/
__pycache__/
.venv/
*.nupkg
*.zip
*.dll
*.pdb

# Third-party packages mirrored for reading, not redistributed: no license.
external/*/osf/

# The dependency census lists (census.*, left-out.md, declared-env.*,
# symbols.*) were kept out of git from 12/10 to 21/10. In git since 21/10 at
# Peter's request, so that Leo has them: they name public NuGet packages,
# versions and repositories only.
